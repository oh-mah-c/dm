\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Runtime and peak RAM on \texttt  {mushrooms}. The low-threshold region produces very large raw outputs; all algorithms emit identical counts, but \textsc  {AURA-HOI}{} pays additional audit and bitset overhead at the lowest thresholds.}}{14}{figure.caption.12}\protected@file@percent }
\newlabel{fig:mushrooms}{{1}{14}{Runtime and peak RAM on \texttt {mushrooms}. The low-threshold region produces very large raw outputs; all algorithms emit identical counts, but \AURA {} pays additional audit and bitset overhead at the lowest thresholds}{figure.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Runtime and peak RAM on \texttt  {chess}. \textsc  {AURA-HOI}{} is faster than \textsc  {HEP}{} across the threshold grid while using stable memory. \textsc  {DFHOI}{} remains slightly faster in runtime, but with similar memory to \textsc  {AURA-HOI}.}}{15}{figure.caption.13}\protected@file@percent }
\newlabel{fig:chess}{{2}{15}{Runtime and peak RAM on \texttt {chess}. \AURA {} is faster than \HEP {} across the threshold grid while using stable memory. \DFHOI {} remains slightly faster in runtime, but with similar memory to \AURA }{figure.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Runtime and peak RAM on \texttt  {retail}. The sparse workload has very small output under the shared threshold. \textsc  {AURA-HOI}{} becomes fastest after the lowest threshold and uses slightly lower resident memory than the baselines.}}{15}{figure.caption.14}\protected@file@percent }
\newlabel{fig:retail}{{3}{15}{Runtime and peak RAM on \texttt {retail}. The sparse workload has very small output under the shared threshold. \AURA {} becomes fastest after the lowest threshold and uses slightly lower resident memory than the baselines}{figure.caption.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Runtime and peak RAM on \texttt  {T10I4D100K}. \textsc  {AURA-HOI}{} is faster than both baselines at every tested threshold, and the memory curves converge once the threshold removes almost all output.}}{16}{figure.caption.15}\protected@file@percent }
\newlabel{fig:t10}{{4}{16}{Runtime and peak RAM on \texttt {T10I4D100K}. \AURA {} is faster than both baselines at every tested threshold, and the memory curves converge once the threshold removes almost all output}{figure.caption.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Runtime and peak RAM on \texttt  {kosarak}. The lowest threshold is the most difficult setting for \textsc  {AURA-HOI}{}, while moderate and high thresholds show competitive or better runtime and memory. This dataset highlights the importance of reporting threshold sensitivity rather than a single aggregate score.}}{16}{figure.caption.16}\protected@file@percent }
\newlabel{fig:kosarak}{{5}{16}{Runtime and peak RAM on \texttt {kosarak}. The lowest threshold is the most difficult setting for \AURA {}, while moderate and high thresholds show competitive or better runtime and memory. This dataset highlights the importance of reporting threshold sensitivity rather than a single aggregate score}{figure.caption.16}{}}
