package(default_visibility = ["//visibility:public"])

cc_library(
    name = "all_core",
    srcs = glob(["*.c"]),
    deps = ["//include:headers"],
    linkopts = select({
        "//:windows": ["Psapi.lib"],
        "//conditions:default": ["-pthread"],
    }),
)

cc_library(
    name = "benchmark",
    srcs = ["dm_benchmark.c"],
    deps = [
        "//include:headers",
        "//src/algorithms:laga_generator",
        ":arena",
    ],
)

cc_library(
    name = "dataset",
    srcs = [
        "dm_dataset.c",
        "dm_registry.c",
    ],
    deps = [
        ":benchmark",
        "//include:headers",
    ],
)

cc_library(
    name = "arena",
    srcs = ["dm_arena.c"],
    deps = ["//include:headers"],
)

cc_library(
    name = "flat_runtime",
    srcs = [
        "dm_arena.c",
        "dm_benchmark.c",
        "dm_flat.c",
        "dm_mmap.c",
    ],
    deps = [
        "//include:headers",
        "//src/algorithms:laga_generator",
    ],
)

cc_library(
    name = "mfhoi_common_core",
    srcs = [
        "csv_writer.c",
        "dataset_stats.c",
        "experiment.c",
        "memory_usage.c",
        "metrics.c",
        "pattern_output.c",
        "timer.c",
    ],
    deps = ["//include:headers"],
)

alias(
    name = "gpu",
    actual = "//src/core/gpu:gpu",
)
