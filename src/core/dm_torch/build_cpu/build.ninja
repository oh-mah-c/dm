build caffe2/CMakeFiles/torch_global_deps.dir/__/torch/csrc/empty.c.o: C_COMPILER__torch_global_deps_unscanned_Release /home/autocookie/pomaieco/dm/src/core/pytorch/torch/csrc/empty.c || cmake_object_order_depends_target_torch_global_deps
