#############################################
# Link the shared library lib/libtorch_global_deps.so

build lib/libtorch_global_deps.so: C_SHARED_LIBRARY_LINKER__torch_global_deps_Release caffe2/CMakeFiles/torch_global_deps.dir/__/torch/csrc/empty.c.o
