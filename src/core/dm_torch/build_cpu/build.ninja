  DESC = Install the project...
  pool = console
  restat = 1

build caffe2/torch/install: phony caffe2/torch/CMakeFiles/install.util


#############################################
# Utility command for install/local

build caffe2/torch/CMakeFiles/install/local.util: CUSTOM_COMMAND caffe2/torch/all
