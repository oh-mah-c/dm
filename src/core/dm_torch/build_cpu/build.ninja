build caffe2/torch/CMakeFiles/test.util: CUSTOM_COMMAND
  COMMAND = cd /home/autocookie/pomaieco/dm/src/core/pytorch/build_cpu/caffe2/torch && /usr/bin/ctest --force-new-ctest-process
  DESC = Running tests...
  pool = console
  restat = 1

build caffe2/torch/test: phony caffe2/torch/CMakeFiles/test.util


#############################################
# Utility command for edit_cache

build caffe2/torch/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /home/autocookie/pomaieco/dm/src/core/pytorch/build_cpu/caffe2/torch && /usr/bin/cmake -E echo No\ interactive\ CMake\ dialog\ available.
  DESC = No interactive CMake dialog available...
  restat = 1

build caffe2/torch/edit_cache: phony caffe2/torch/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build caffe2/torch/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /home/autocookie/pomaieco/dm/src/core/pytorch/build_cpu/caffe2/torch && /usr/bin/cmake --regenerate-during-build -S/home/autocookie/pomaieco/dm/src/core/pytorch -B/home/autocookie/pomaieco/dm/src/core/pytorch/build_cpu
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build caffe2/torch/rebuild_cache: phony caffe2/torch/CMakeFiles/rebuild_cache.util


